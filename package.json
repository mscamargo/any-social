{
  "name": "any-social",
  "version": "1.0.0",
  "type": "module",
  "repository": "git@github.com:mscamargo/any-social.git",
  "author": "mscamargo <mscamargo.dev@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "migrate": "node --env-file-if-exists=.env src/database/migrate.js",
    "lint": "biome check",
    "format": "biome check --write",
    "pretest": "NODE_ENV=test node src/database/migrate.js --reset",
    "test": "NODE_ENV=test node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/config/**' --test-coverage-exclude='src/database/**' --test-coverage-exclude='src/exceptions/**' '__tests__/**/*.test.js'"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3"
  },
  "overrides": {
    "node-releases": "2.0.44"
  }
}
